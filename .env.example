# Server
NODE_ENV=development
PORT=3001
# Required in production. At least 32 random characters.
SESSION_SECRET=replace_with_a_long_random_string
# Set to true when the app is behind an HTTPS reverse proxy.
TRUST_PROXY=false

# COTO / HighLevel private integration. Never expose the token to the browser.
COTO_API_BASE_URL=https://services.leadconnectorhq.com
COTO_LOCATION_ID=7WK4Pl3TZvOBAwTB2gOR
# Verified with the existing private integration. Current HighLevel docs label the header value "v3".
COTO_API_VERSION=2021-07-28
COTO_PRIVATE_INTEGRATION_TOKEN=replace_with_your_token
# CRM web app used for "Open in COTO" links.
COTO_APP_BASE_URL=https://crm.coto.services

# Optional. Force simulated CRM data in local development even if a token is present.
# Ignored in production.
COTO_USE_MOCK=false

# Optional overrides when automatic custom-field detection is not right.
# Use the custom field id from COTO, not the display name.
COTO_FIELD_NPI=
COTO_FIELD_TITLE=

# Used only by `npm run coto:check`. Read-only unless you also set the write flag.
COTO_TEST_QUERY=
COTO_TEST_CONTACT_ID=
# Must be exactly "true" to allow the check script to create a note on the test contact.
COTO_ALLOW_WRITE_TESTS=false

# Used by `npm run staff:add` if you prefer environment variables to arguments.
STAFF_NAME=
STAFF_EMAIL=
STAFF_PASSWORD=
