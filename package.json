{
  "name": "aaoptom-inquiry",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "build": "vue-tsc -p client/tsconfig.json --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/src/index.ts",
    "typecheck": "vue-tsc -p client/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "staff:add": "tsx server/src/scripts/add-staff.ts",
    "staff:list": "tsx server/src/scripts/list-staff.ts",
    "coto:check": "tsx server/src/scripts/check-coto.ts"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/lato": "^5.2.1",
    "@fontsource/lora": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "@paddleocr/paddleocr-js": "^0.4.2",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "lucide-vue-next": "^0.487.0",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "concurrently": "^9.1.2",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.5",
    "vitest": "^3.1.1",
    "vue-tsc": "^2.2.8"
  }
}
